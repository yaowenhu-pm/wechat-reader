{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "按自定义栏目整理的交付内容",
  "type": "object", "additionalProperties": false,
  "required": ["title", "summary", "sections"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "sections": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "items"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "items": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["title", "body", "sources"],
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "body": {"type": "string", "minLength": 1},
            "sources": {"type": "array", "minItems": 1, "items": {
              "type": "object", "additionalProperties": false, "required": ["article_id", "content_hash", "quote"],
              "properties": {
                "article_id": {"type": "string", "minLength": 1},
                "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "quote": {"type": "string", "minLength": 1}
              }
            }}
          }
        }}
      }
    }}
  }
}
